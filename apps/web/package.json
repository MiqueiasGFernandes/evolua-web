{
  "name": "web",
  "private": true,
  "type": "module",
  "scripts": {
    "dev": "next dev",
    "build": "next build",
    "lint": "eslint . --max-warnings=0",
    "typecheck": "tsc --noEmit",
    "test": "vitest run",
    "test:e2e": "playwright test --project=chromium-functional",
    "test:e2e:all": "playwright test --project=chromium-functional --project=firefox-functional --project=webkit-functional",
    "test:a11y": "playwright test tests/a11y --project=chromium-functional",
    "test:visual": "playwright test tests/visual --project=chromium-visual --update-snapshots=none"
  },
  "dependencies": {
    "@hookform/resolvers": "^3.0.0",
    "@tanstack/react-query": "^5.0.0",
    "class-variance-authority": "0.7.1",
    "clsx": "2.1.1",
    "next": "^15.0.0",
    "react": "^19.0.0",
    "react-dom": "^19.0.0",
    "react-hook-form": "^7.0.0",
    "tailwind-merge": "3.4.0",
    "zod": "^3.0.0"
  },
  "devDependencies": {
    "@axe-core/playwright": "4.11.0",
    "@eslint/eslintrc": "3.3.1",
    "@fontsource/newsreader": "5.2.8",
    "@fontsource/source-sans-3": "5.2.8",
    "@playwright/test": "1.57.0",
    "@tailwindcss/postcss": "4.1.17",
    "@testing-library/jest-dom": "6.9.1",
    "@testing-library/react": "16.3.0",
    "@testing-library/user-event": "14.6.1",
    "@types/node": "^22.0.0",
    "@types/react": "^19.0.0",
    "@types/react-dom": "^19.0.0",
    "@vitejs/plugin-react": "4.3.4",
    "eslint": "9.39.1",
    "eslint-config-next": "15.5.29",
    "jsdom": "^25.0.0",
    "postcss": "8.5.6",
    "tailwindcss": "4.1.17",
    "typescript": "^5.0.0",
    "vitest": "^2.0.0"
  }
}
